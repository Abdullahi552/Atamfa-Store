# Copy to .env.local to override the defaults for local work.

# Base URL of the backend REST API. Use a relative path when the frontend and the API
# are served from the same domain (or proxied), or a full URL otherwise.
VITE_API_BASE_URL=/api

# Where uploaded files (avatars, logo) are served from, when the API returns relative paths.
VITE_ASSET_BASE_URL=

# Dev server only: where /api is proxied to.
VITE_PROXY_TARGET=http://localhost:5000

# true  = run against the built-in in-memory mock API (no backend needed)
# false = talk to the real backend
VITE_USE_MOCK=false

VITE_APP_NAME=Atamfa POS
